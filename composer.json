{
    "name": "erwane/openagenda-wrapper-guzzle",
    "description": "Guzzle wrapper for erwane/openagenda-api package.",
    "type": "library",
    "keywords": [
        "openagenda",
        "guzzle"
    ],
    "homepage": "https://github.com/Erwane/openagenda-wrapper-guzzle",
    "support": {
        "issues": "https://github.com/Erwane/openagenda-wrapper-guzzle/issues",
        "source": "https://github.com/Erwane/openagenda-wrapper-guzzle"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Erwane",
            "email": "erwane@phea.fr",
            "homepage": "https://erwane-breton.fr"
        }
    ],
    "require": {
        "php": "^8.0, <8.2",
        "ext-json": "*",
        "erwane/openagenda-api": "^3.1",
        "guzzlehttp/guzzle": "^v6.0 | ^v7.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^4.0",
        "phpunit/phpunit": "^9.6 | ^10.5",
        "symfony/var-dumper": "^v6.0"
    },
    "autoload": {
        "psr-4": {
            "OpenAgenda\\Wrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenAgenda\\Wrapper\\Test\\": "tests/"
        }
    },
    "scripts": {
        "cscheck": "vendor/bin/phpcs -p -s src tests",
        "csfix": "vendor/bin/phpcbf src tests"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
